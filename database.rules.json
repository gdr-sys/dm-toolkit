{
  "rules": {
    ".read": false,
    ".write": false,

    "utenti": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "campagne": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",

        "presenza": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    }
  }
}
